# Workspace-level ignores for all Udemy projects

# editor and system
.idea/
.vscode/
.DS_Store
Thumbs.db

# dependencies and package manager state
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# build artifacts
**/.next/
**/out/
**/build/
**/dist/
**/coverage/
**/.vercel/
**/*.tsbuildinfo

# local env files
**/.env*
!**/.env.example

# logs and debug files
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
**/*.log

# misc local artifacts
**/*.pem
**/out.zip
